# Deployment production TMS. Sesuai Architecture Document Bagian 8.1: TMS
# berbagi instance MySQL yang sama dengan SYOP native, jadi TIDAK ADA service
# mysql di sini — app & scheduler konek ke MySQL yang sudah jalan di host
# lewat host.docker.internal (lihat extra_hosts di bawah).
#
# INI TEMPLATE, bukan file yang dipakai langsung — docker-compose.yml
# (tanpa ".example") sengaja di-gitignore, supaya kustomisasi manual di
# server (IP NFS, port, dst) tidak pernah bentrok lagi dengan "git pull".
#
# Setup SEKALI di server:
#   cp docker-compose.yml.example docker-compose.yml
#   cp backend/.env.docker.example backend/.env   # lalu isi semua <ISI>
#   cp .env.example .env                          # lalu isi NFS_ADDR/NFS_PATH/WEB_PORT/SYOP_URL
#
# Setelah itu docker-compose.yml boleh diedit bebas langsung di server
# (git tidak akan pernah menyentuhnya lagi) — kalau ada versi baru dari
# git (docker-compose.yml.example berubah), bandingkan manual & gabungkan
# perubahannya sendiri ke docker-compose.yml server, JANGAN di-copy timpa
# begitu saja (bisa menghapus kustomisasi server yang sudah ada).
volumes:
  # Storage NFS shared (attachment upload dsb.) — persisten lintas rebuild
  # image DAN lintas host kalau container dipindah node. IP/path diambil dari
  # .env di root (bukan hardcode di sini) karena repo ini public.
  tms_storage_nfs:
    driver: local
    driver_opts:
      type: "nfs"
      o: "addr=${NFS_ADDR},nfsvers=4.1,rw,hard,timeo=600"
      device: ":${NFS_PATH}"

services:
  app:
    container_name: tms-backend
    build:
      context: ./backend
      dockerfile: Dockerfile
    image: tms-backend:latest
    restart: unless-stopped
    command: ["app"]
    env_file:
      - ./backend/.env
    volumes:
      # ./backend:/var/www/html — live-mount kode host ke container, supaya
      # ganti kode (git pull di host) tidak perlu rebuild image penuh.
      # SEBELUMNYA ini bikin error "vendor/autoload.php not found" (bind-mount
      # menimpa vendor/ hasil build image dengan folder host yang tidak
      # punya vendor/ sama sekali, vendor/ di-gitignore) — sekarang aman
      # karena docker/entrypoint.sh mendeteksi vendor/composer.lock berubah
      # dan otomatis composer install ulang saat container start (dicek
      # lewat hash file vendor/.composer-lock-hash). Kalau bind-mount ini
      # mau dihapus lagi (balik ke pola "image dibekukan penuh"), pastikan
      # logic composer-install-otomatis di entrypoint.sh juga disesuaikan,
      # jangan cuma menghapus baris ini saja.
      - ./backend:/var/www/html
      - tms_storage_nfs:/var/www/html/storage/app
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - tms

  scheduler:
    container_name: tms-scheduler
    build:
      context: ./backend
      dockerfile: Dockerfile
    image: tms-backend:latest
    restart: unless-stopped
    command: ["scheduler"]
    env_file:
      - ./backend/.env
    volumes:
      - ./backend:/var/www/html
      - tms_storage_nfs:/var/www/html/storage/app
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - app
    networks:
      - tms

  web:
    container_name: tms-frontend
    build:
      context: ./frontend
      dockerfile: Dockerfile
      args:
        VITE_API_BASE_URL: /api/v1
        VITE_SYOP_URL: ${SYOP_URL}
    image: tms-frontend:latest
    restart: unless-stopped
    ports:
      - "${WEB_PORT}:80"
    depends_on:
      - app
    networks:
      - tms
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost/up"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

networks:
  tms:
    driver: bridge
