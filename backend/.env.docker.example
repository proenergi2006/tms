# Template .env untuk deployment Docker (production) — beda dari
# .env.example biasa (untuk `php artisan serve` langsung di host). Copy ke
# backend/.env di SERVER, isi nilai sebenarnya, JANGAN commit ke git.
#
# Cara pakai di server:
#   cp backend/.env.docker.example backend/.env
#   php artisan key:generate --show   # generate APP_KEY baru, tempel di bawah
#   # isi semua nilai bertanda <ISI> lalu jalankan docker compose up -d --build

APP_NAME=TMS
APP_ENV=production
APP_KEY=<ISI: hasil `php artisan key:generate --show`, JANGAN pakai APP_KEY dev>
APP_DEBUG=false
APP_URL=<ISI: https://tms.proenergi.co.id atau domain production sebenarnya>

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# tms_db — instance MySQL yang sama dengan SYOP native (Architecture Document
# Bagian 8.1). host.docker.internal dipetakan ke host lewat extra_hosts di
# docker-compose.yml (jalan di Linux Docker 20.10+ maupun Docker Desktop) —
# ganti ke IP LAN MySQL kalau instance-nya bukan di host yang sama persis
# dengan Docker engine ini.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=tms_db
DB_USERNAME=<ISI: user MySQL khusus TMS, read-write ke tms_db>
DB_PASSWORD=<ISI>

# Koneksi read-only ke database SYOP native — kredensial terbatas, HANYA
# SELECT (Architecture Document Bagian 10). "proenergi" itu cuma nama
# database di environment dev lokal, BELUM TENTU sama di server production
# — cek nama database SYOP yang sebenarnya di server sebelum isi ini.
SYOP_DB_HOST=host.docker.internal
SYOP_DB_PORT=3306
SYOP_DB_DATABASE=<ISI: nama database SYOP native yang SEBENARNYA di server, cek dulu jangan asumsi "proenergi">
SYOP_DB_USERNAME=<ISI: user read-only>
SYOP_DB_PASSWORD=<ISI>

# Key/AAD SSO dari tim SYOP — lihat App\Http\Controllers\SsoController.
SYOP_SSO_KEY=<ISI>
SYOP_SSO_AAD=syop-v3-to-v4

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# SMTP untuk email notifikasi (lihat App\Services\NotificationService).
# "log" cuma tulis ke storage/logs, TIDAK benar-benar terkirim — ganti ke
# "smtp" begitu kredensial provider mail sudah ada.
MAIL_MAILER=<ISI: smtp>
MAIL_HOST=<ISI: mis. smtp.gmail.com / email-smtp.ap-southeast-1.amazonaws.com>
MAIL_PORT=<ISI: 587 (TLS) umumnya>
MAIL_USERNAME=<ISI>
MAIL_PASSWORD=<ISI>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<ISI: mis. noreply@proenergi.co.id>
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
