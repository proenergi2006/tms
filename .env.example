# Variabel untuk docker-compose.yml (bukan backend/.env — itu terpisah,
# lihat backend/.env.docker.example). Copy ke ".env" di root ini, isi nilai
# sebenarnya, JANGAN commit — repo ini public, IP/path internal server tidak
# boleh terekspos.
#
#   cp .env.example .env

# Alamat & path NFS storage/tms-live untuk backend_storage volume.
NFS_ADDR=<ISI: IP server NFS>
NFS_PATH=<ISI: path share NFS, contoh /ProEnergi-DFS-X1U23-33276fd7/tms-live>

# Port host untuk container web (frontend+proxy) — reverse proxy existing
# mengarah ke port ini.
WEB_PORT=8150
